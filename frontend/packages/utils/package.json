{
  "name": "@openarchive/utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared frontend utilities.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "lint": "eslint .",
    "test": "tsc --project tsconfig.tests.json && jest && playwright test --tsconfig ../../tsconfig.test.json",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@openarchive/config-eslint": "0.1.0",
    "@openarchive/config-jest": "0.1.0",
    "@openarchive/config-playwright": "0.1.0",
    "@openarchive/config-prettier": "0.1.0",
    "@openarchive/config-typescript": "0.1.0",
    "@openarchive/config-vite": "0.1.0",
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.0",
    "prettier": "3.6.0",
    "react": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
