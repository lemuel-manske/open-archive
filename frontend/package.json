{
  "name": "@open-archive/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web interface for OpenArchive.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemuel-manske/open-archive.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/lemuel-manske/open-archive#readme",
  "bugs": {
    "url": "https://github.com/lemuel-manske/open-archive/issues"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsc --project tsconfig.tools.json && jest && playwright test --tsconfig tsconfig.test.json"
  },
  "dependencies": {
    "@lemuel-manske/components": "1.0.0",
    "@lemuel-manske/design-tokens": "1.0.0",
    "@lemuel-manske/utils": "1.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@lemuel-manske/config-eslint": "1.0.0",
    "@lemuel-manske/config-jest": "1.0.0",
    "@lemuel-manske/config-playwright": "1.0.0",
    "@lemuel-manske/config-prettier": "1.0.0",
    "@lemuel-manske/config-typescript": "1.0.0",
    "@lemuel-manske/config-vite": "1.0.0",
    "@playwright/experimental-ct-react": "1.62.0",
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.0",
    "globals": "16.0.0",
    "prettier": "3.6.0",
    "typescript": "5.9.3",
    "vite": "7.1.0"
  },
  "overrides": {
    "playwright-core": "1.62.0"
  }
}
