{
  "name": "@open-archive/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web interface for OpenArchive.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemuel-manske/open-archive.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/lemuel-manske/open-archive#readme",
  "bugs": {
    "url": "https://github.com/lemuel-manske/open-archive/issues"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "prettier --check . '!src/i18n/message-ids.ts'",
    "format:fix": "prettier --write . '!src/i18n/message-ids.ts'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run i18n:check && tsc --project tsconfig.tools.json && jest && playwright test --tsconfig tsconfig.test.json",
    "i18n": "i18n-message-ids locales/pt-BR.json src/i18n/message-ids.ts locales/en.json",
    "i18n:check": "i18n-message-ids --check locales/pt-BR.json src/i18n/message-ids.ts locales/en.json"
  },
  "dependencies": {
    "@lemuel-manske/components": "2.0.0",
    "@lemuel-manske/design-tokens": "2.0.0",
    "@lemuel-manske/i18n": "2.0.0",
    "@lemuel-manske/utils": "2.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@lemuel-manske/config-eslint": "2.0.0",
    "@lemuel-manske/config-jest": "2.0.0",
    "@lemuel-manske/config-playwright": "2.0.0",
    "@lemuel-manske/config-prettier": "2.0.0",
    "@lemuel-manske/config-typescript": "2.0.0",
    "@lemuel-manske/config-vite": "2.0.0",
    "@playwright/experimental-ct-react": "1.62.0",
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "globals": "16.0.0",
    "prettier": "3.6.0",
    "typescript": "5.9.3",
    "vite": "7.1.0"
  },
  "overrides": {
    "playwright-core": "1.62.0"
  }
}
