{
  "name": "@openarchive/frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "description": "Web interface for OpenArchive.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemuel-manske/open-archive.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/lemuel-manske/open-archive#readme",
  "bugs": {
    "url": "https://github.com/lemuel-manske/open-archive/issues"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "npm run build:components && tsc -b && vite build",
    "build:components": "npm run build --workspace @openarchive/design-tokens && npm run build --workspace @openarchive/utils && npm run build --workspace @openarchive/components",
    "build:storybook": "npm run build:components && npm run build:storybook --workspace @openarchive/components",
    "dev": "npm run build:components && vite",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . && npm run lint --workspaces",
    "lint:fix": "eslint . --fix && npm run lint:fix --workspaces",
    "storybook": "npm run build:components && npm run storybook --workspace @openarchive/components",
    "test": "npm run build:components && tsc -b && tsc --project tsconfig.tools.json && jest && npm run test --workspaces --if-present && playwright test --tsconfig tsconfig.test.json"
  },
  "dependencies": {
    "@openarchive/components": "0.1.0",
    "@openarchive/utils": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@openarchive/config-eslint": "0.1.0",
    "@openarchive/config-jest": "0.1.0",
    "@openarchive/config-playwright": "0.1.0",
    "@openarchive/config-prettier": "0.1.0",
    "@openarchive/config-typescript": "0.1.0",
    "@openarchive/config-vite": "0.1.0",
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.0",
    "globals": "16.0.0",
    "prettier": "3.6.0",
    "typescript": "5.9.3",
    "vite": "7.1.0"
  },
  "overrides": {
    "playwright-core": "1.62.0"
  }
}
